{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benvoliobenji.github.io/pkgmgr-registry/schema/profile.schema.json",
  "title": "Target profile",
  "description": "The USB layout a target device expects. The file name must be <id>.json. Bump version on every change so drives can be migrated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "filesystems", "slots"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 300 },
    "version": { "type": "integer", "minimum": 1 },
    "filesystems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/filesystem" }
    },
    "maxFileBytes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/filesystem" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "volumeLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": { "type": "string", "format": "regex" },
        "required": { "type": "boolean", "default": false }
      }
    },
    "requiredDirs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relPath" }
    },
    "slots": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,31}$" },
      "additionalProperties": { "$ref": "#/$defs/slot" }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": { "type": "string", "format": "regex" },
        "case": { "enum": ["lower", "upper", "any"], "default": "any" }
      }
    },
    "reserved": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "filesystem": {
      "enum": ["fat32", "exfat", "ntfs", "apfs", "hfsplus", "ext4"]
    },
    "relPath": {
      "description": "A drive-relative path using forward slashes. Empty means the drive root. May use {id}, {version} and {format}.",
      "type": "string",
      "pattern": "^(?:[^/\\\\<>:\"|?*\\u0000-\\u001f]+(?:/[^/\\\\<>:\"|?*\\u0000-\\u001f]+)*)?$"
    },
    "fileName": {
      "description": "A single file name. May use {id}, {version} and {format}.",
      "type": "string",
      "pattern": "^[^/\\\\<>:\"|?*\\u0000-\\u001f]+$"
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "allow", "extract"],
      "properties": {
        "description": { "type": "string", "maxLength": 200 },
        "path": {
          "$ref": "#/$defs/relPath",
          "description": "Folder the package file is written to."
        },
        "file": {
          "$ref": "#/$defs/fileName",
          "description": "File name on the drive. Defaults to the asset's own file name."
        },
        "allow": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["zip", "tar"] }
        },
        "extract": { "enum": ["never", "optional", "always"] },
        "extractDir": {
          "$ref": "#/$defs/relPath",
          "description": "Folder a zip is unpacked into. Must contain {id}. Defaults to <path>/{id}."
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum packages installed in this slot at once."
        }
      }
    }
  }
}
