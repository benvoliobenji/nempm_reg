{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benvoliobenji.github.io/pkgmgr-registry/schema/package.schema.json",
  "title": "Package manifest",
  "description": "One installable package. The file name must be <id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "version",
    "format",
    "url",
    "sha256",
    "size",
    "slot",
    "profiles"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "One line shown on the card."
    },
    "version": {
      "type": "string",
      "description": "Semantic version. Must increase on every change.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?$"
    },
    "format": { "enum": ["zip", "tar"] },
    "core": {
      "type": "boolean",
      "default": false,
      "description": "The core package. Installed before everything else."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "A GitHub Release asset download URL on a repo with immutable releases enabled.",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[^/]+/[^/]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase hex SHA-256 of the asset."
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "description": "Asset size in bytes."
    },
    "extract": {
      "type": "boolean",
      "default": false,
      "description": "Default for unpacking a zip on the drive. Users can override per install."
    },
    "slot": {
      "$ref": "#/$defs/slotName",
      "description": "A slot name from each listed target profile."
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "deps": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "items": { "$ref": "#/$defs/id" }
    },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "format": { "const": "tar" } },
        "required": ["format"]
      },
      "then": { "properties": { "extract": { "const": false } } }
    },
    {
      "if": {
        "properties": { "core": { "const": true } },
        "required": ["core"]
      },
      "then": {
        "properties": {
          "format": { "const": "tar" },
          "extract": { "const": false }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "slotName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" }
  }
}
